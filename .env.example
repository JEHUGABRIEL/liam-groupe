# ============================================================
# LIAM Groupe — Variables d'environnement
# ============================================================
# Copier ce fichier en .env et remplacer les valeurs
#   cp .env.example .env
# ============================================================
#
# ⚠️  NE JAMAIS commiter le fichier .env ! Il contient des clés sensibles.
# ⚠️  .env.example peut être commité (il ne contient que des valeurs factices).
#
# Variables préfixées par NEXT_PUBLIC_ → accessibles côté client (navigateur)
# Variables sans préfixe → accessibles uniquement côté serveur
# ============================================================

# ──────────────────────────────────────────────
# SUPABASE — Base de données & Authentification
# ──────────────────────────────────────────────
# Obtenir ces clés depuis : Settings → API → Project API keys
# dans le dashboard Supabase (https://supabase.com/dashboard)

# URL du projet Supabase (obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anon/publique (obligatoire) — utilisée côté client
# Permet la lecture publique et l'écriture restreinte par RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_votre-cle-anon

# Clé service_role (optionnelle, réservée scripts serveur)
# ⚠️  NE PAS utiliser dans le bundle client !
# SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ──────────────────────────────────────────────
# CLOUDINARY — Hébergement & Optimisation d'images
# ──────────────────────────────────────────────
# Obtenir ces clés depuis : Dashboard → Settings → Access Keys
# dans le dashboard Cloudinary (https://cloudinary.com/console)

# Nom du cloud Cloudinary (obligatoire)
# Utilisé côté client (constructeur d'URLs d'images) et côté serveur
CLOUDINARY_CLOUD_NAME=votre-cloud-name

# Variante accessible côté client (optionnel, uniquement si besoin)
# Si défini, NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME prime sur CLOUDINARY_CLOUD_NAME
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre-cloud-name

# Clé API Cloudinary (obligatoire pour les opérations serveur)
CLOUDINARY_API_KEY=votre-api-key

# Secret API Cloudinary (obligatoire pour les opérations serveur)
# ⚠️  Variable sensible — ne jamais exposer côté client
CLOUDINARY_API_SECRET=votre-api-secret

# ──────────────────────────────────────────────
# SITE — Configuration générale
# ──────────────────────────────────────────────
# (Aucune variable additionnelle requise pour l'instant)
