# LIAM Groupe — frontend Next.js
#   cp .env.example .env.local
#
# Le navigateur ne parle qu'à Next.js : les appels à l'API passent par les routes
# /api/session/* et /api/proxy/* (jetons gardés en cookies httpOnly). Aucune
# variable NEXT_PUBLIC_ n'est nécessaire.

# URL de l'API Spring Boot (liam-groupe-api), vue depuis le serveur Next.js
API_URL=http://localhost:8000

# URL publique du site (sitemap, liens absolus)
SITE_URL=https://liamgroupe.org
